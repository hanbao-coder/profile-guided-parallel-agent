{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ParallelPlan",
  "type": "object",
  "required": [
    "schema_version",
    "source_path",
    "parallelizable",
    "backend",
    "strategy",
    "workers",
    "chunks",
    "correctness_gate",
    "fallback",
    "reasons"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "source_path": {"type": "string", "minLength": 1},
    "parallelizable": {"type": "boolean"},
    "backend": {"enum": ["multiprocessing", "serial"]},
    "strategy": {"enum": ["map_reduce", "serial"]},
    "workers": {"type": "integer", "minimum": 1},
    "chunks": {"type": "integer", "minimum": 1},
    "correctness_gate": {"const": true},
    "fallback": {"const": "serial"},
    "reasons": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}

