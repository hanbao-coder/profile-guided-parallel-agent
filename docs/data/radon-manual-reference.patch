 class CCHarvester(Harvester):
     '''A class that analyzes Python modules' Cyclomatic Complexity.'''
 
+    def run(self):
+        """Analyze larger file batches in workers while preserving result order."""
+        filenames = list(self._iter_filenames())
+        if len(filenames) < 8 or '-' in filenames:
+            yield from super().run()
+            return
+
+        workers = min(os.cpu_count() or 1, len(filenames))
+        chunksize = max(1, len(filenames) // (workers * 4))
+        payloads = [
+            (
+                name,
+                self.config.no_assert,
+                self.config.show_closures,
+                self.config.include_ipynb,
+                self.config.ipynb_cells,
+            )
+            for name in filenames
+        ]
+        with ProcessPoolExecutor(max_workers=workers) as executor:
+            for file_results in executor.map(
+                _cc_analyze_file,
+                payloads,
+                chunksize=chunksize,
+            ):
+                for result_name, blocks in file_results:
+                    if isinstance(blocks, dict) and 'error' in blocks:
+                        yield result_name, blocks
+                    else:
