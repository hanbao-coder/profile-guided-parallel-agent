+def _cc_analyze_file(payload):
+    """Analyze one path without serializing a Harvester or Config object."""
+    (
+        name,
+        no_assert,
+        show_closures,
+        include_ipynb,
+        ipynb_cells,
+    ) = payload
+    with _open(name) as fobj:
+        try:
+            if name.endswith('.ipynb'):
+                if not (SUPPORTS_IPYNB and include_ipynb):
+                    return []
+                nb = nbformat.read(fobj, as_version=nbformat.NO_CONVERT)
+                cells = [
+                    cell.source for cell in nb.cells if cell.cell_type == 'code'
+                ]
+                sources = [(name, "\n".join(cells))]
+                if ipynb_cells:
+                    sources.extend(
+                        ("{0}:[{1}]".format(name, cellid), source)
+                        for cellid, source in enumerate(cells)
+                    )
+            else:
+                sources = [(name, fobj.read())]
+
+            results = []
+            for result_name, source in sources:
+                blocks = cc_visit(
+                    strip_ipython(source) if name.endswith('.ipynb') else source,
+                    no_assert=no_assert,
+                )
+                if show_closures:
+                    blocks = add_inner_blocks(blocks)
+                results.append((result_name, blocks))
+            return results
+        except Exception as exc:
+            return [(name, {'error': str(exc)})]
